<UserControl x:Class="TaskFocuser.Views.SettingsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TaskFocuser.Views"
             Height="34" Focusable="False" IsTabStop="False">
    <!-- One row of 34 DIP again (SPEC-round3 2.1), in his order: perch, cucumber, bird pinned, bird opacity,
         volume, colours, opacity, - f +, plants, padlock (SPEC-round4 2.1: the opacity slider moved behind the
         colours, so it no longer reads as the volume's slider). The background is transparent but hit-testable: the
         empty stretches are where the note is grabbed (and double-clicked to lock) while unlocked. The strip
         colour is painted by the note behind this control. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="TF.InkName" Color="#2B2A25" Opacity="0.75" />
        <!-- Round 5 (SPEC-round5 2.3): the bird's name under the bird, which is also the picker's handle. Small
             ink text, underlined on hover so it reads as a link; never focusable, so the caret stays in the note. -->
        <Style x:Key="TF.NameSlot" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TF.InkName}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2,0,2,1">
                            <TextBlock x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Background="Transparent" LastChildFill="False">
        <!-- The perch: the bird stands on the note's top edge right above this slot, 56 DIP since round 5 so a
             twelve-character name fits under it. The upper half stays empty bar (a grab, half a double-click);
             the name sits on the bar's centre line under the feet. -->
        <Grid x:Name="PerchSlot" DockPanel.Dock="Left" Width="56">
            <!-- Centred on the bird's feet (32 DIP from the paper's left, 4 right of the slot's middle) and on the bar's
                 centre line like every other control, so the row keeps one baseline (his ask after round 5). -->
            <Button x:Name="NameButton" Style="{StaticResource TF.NameSlot}" Height="17" MaxWidth="56" Margin="8,0,0,0"
                    HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Pick or rename the companion" />
        </Grid>

        <Button x:Name="LockButton" DockPanel.Dock="Right" Style="{StaticResource TF.Glyph}" Width="22"
                Margin="0,0,4,0" Content="&#xE72E;" ToolTip="Lock (Esc)" />

        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Item 3: the endless treat supply right beside the bird; the note runs its drag. The cucumber is the
                 birds', the bone Rori's (SPEC-round6 2.6): the code swaps the image and its size with the companion. -->
            <Border x:Name="Cucumber" Style="{StaticResource TF.SliceHandle}" ToolTip="Drag onto the companion">
                <Image x:Name="TreatImage" Source="{StaticResource TF.CucumberSlice}" Width="14" Height="14"
                       IsHitTestVisible="False" SnapsToDevicePixels="True" />
            </Border>

            <ToggleButton x:Name="StaysToggle" Style="{StaticResource TF.Toggle}" ToolTip="Companion stays when locked">
                <Grid>
                    <!-- Off: an arrow up, the bird leaves upward on lock. -->
                    <Path x:Name="StaysOff" Style="{StaticResource TF.GlyphStroke}"
                          Data="M 7,12.5 L 7,2.6 M 3.2,6.4 L 7,2.6 L 10.8,6.4" />
                    <!-- On: the bird's head in a nest, it stays put. -->
                    <Grid x:Name="StaysOn">
                        <Path Style="{StaticResource TF.GlyphFill}"
                              Data="F1 M 4.6,4.6 A 2.4,2.4 0 1 0 9.4,4.6 A 2.4,2.4 0 1 0 4.6,4.6 Z M 9.1,3.9 L 11,4.6 L 9.1,5.3 Z M 1,7.6 L 13,7.6 C 13,11 10.4,13.2 7,13.2 C 3.6,13.2 1,11 1,7.6 Z" />
                        <Path Style="{StaticResource TF.GlyphStroke}" StrokeThickness="1.1"
                              Data="M 0.4,6.9 L 2.8,7.9 M 13.6,6.9 L 11.2,7.9" />
                    </Grid>
                </Grid>
            </ToggleButton>

            <ToggleButton x:Name="OpaqueToggle" Style="{StaticResource TF.Toggle}" ToolTip="Companion always opaque">
                <Grid>
                    <!-- Off: a see-through bird (it follows the note's opacity); a plain pale fill, since an outline would
                         trace where the head and the body overlap. -->
                    <Path x:Name="OpaqueOff" Style="{StaticResource TF.GlyphFill}" Data="{StaticResource TF.BirdGlyph}">
                        <Path.Fill>
                            <SolidColorBrush Color="#2B2A25" Opacity="0.38" />
                        </Path.Fill>
                    </Path>
                    <!-- On: a solid bird. -->
                    <Path x:Name="OpaqueOn" Style="{StaticResource TF.GlyphFill}" Data="{StaticResource TF.BirdGlyph}" />
                </Grid>
            </ToggleButton>

            <!-- The volume button: click mutes, a hover opens the popup below. The tooltip goes above, so it
                 never sits on top of the popup. -->
            <ToggleButton x:Name="SoundToggle" Style="{StaticResource TF.Toggle}"
                          ToolTip="Sound on or off (hover for the volume and the idle sounds)"
                          ToolTipService.Placement="Top" ToolTipService.InitialShowDelay="900">
                <Grid>
                    <Path Style="{StaticResource TF.GlyphFill}" Data="M 1.5,5 L 4.5,5 L 8,2 L 8,12 L 4.5,9 L 1.5,9 Z" />
                    <!-- On: sound waves. Off: a cross, muted. -->
                    <Path x:Name="SoundOnWaves" Style="{StaticResource TF.GlyphStroke}" StrokeThickness="1.3"
                          Data="M 10,5.2 Q 11.3,7 10,8.8 M 11.7,3.4 Q 14.2,7 11.7,10.6" />
                    <Path x:Name="SoundOffCross" Style="{StaticResource TF.GlyphStroke}" StrokeThickness="1.3"
                          Data="M 10,5.2 L 13.4,8.8 M 13.4,5.2 L 10,8.8" />
                </Grid>
            </ToggleButton>

            <!-- The swatches sit right after the volume now; a small gap keeps the first one off the speaker. -->
            <StackPanel x:Name="Swatches" Orientation="Horizontal" Margin="3,0,0,0" />

            <Slider x:Name="OpacitySlider" Style="{StaticResource TF.Slider}" Width="52" Margin="4,0,6,0"
                    Minimum="20" Maximum="100" SmallChange="5" LargeChange="10" ToolTip="Opacity" />

            <Button x:Name="SmallerButton" Style="{StaticResource TF.TextGlyph}" FontSize="14"
                    Content="&#x2212;" ToolTip="Smaller text (Ctrl+-)" />
            <Button x:Name="FontButton" Style="{StaticResource TF.FontGlyph}" Content="f" />
            <Button x:Name="BiggerButton" Style="{StaticResource TF.TextGlyph}" FontSize="14"
                    Content="+" ToolTip="Bigger text (Ctrl+=)" />

            <!-- Item 7: the plants. On, a solid leaf; off, its outline. -->
            <ToggleButton x:Name="PlantsToggle" Style="{StaticResource TF.Toggle}" Margin="2,0,0,0"
                          ToolTip="Plants in the corner">
                <Grid>
                    <Grid x:Name="PlantsOnGlyph">
                        <Path Style="{StaticResource TF.GlyphFill}"
                              Data="F1 M 3,11 C 3,5.6 6.4,2.4 12.2,2.2 C 12.2,7.8 8.8,11 3,11 Z" />
                        <Path Style="{StaticResource TF.GlyphStroke}" StrokeThickness="1.3" Data="M 1.4,12.6 L 4.4,9.6" />
                    </Grid>
                    <Path x:Name="PlantsOffGlyph" Style="{StaticResource TF.GlyphStroke}" StrokeThickness="1.2"
                          Data="M 3,11 C 3,5.6 6.4,2.4 12.2,2.2 C 12.2,7.8 8.8,11 3,11 Z M 1.4,12.6 L 8.6,5.6" />
                </Grid>
            </ToggleButton>
        </StackPanel>

        <!-- The volume popup (SPEC-round3 2.1). StaysOpen with the bar's own timers opening and closing it:
             StaysOpen=False would take the mouse capture and eat his next click. Nothing inside is focusable,
             and a WPF popup window never activates, so the caret stays in the note. -->
        <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=SoundToggle}" Placement="Bottom"
               VerticalOffset="6" HorizontalOffset="-8" StaysOpen="True" AllowsTransparency="True"
               Focusable="False" PopupAnimation="None">
            <Border x:Name="VolumeBox" BorderThickness="1" CornerRadius="6" Padding="8" Focusable="False">
                <StackPanel Focusable="False">
                    <!-- The thumb position is Sound.VolumeToSlider(volume): the left half of the track is 0 to 10 %. -->
                    <Slider x:Name="VolumeSlider" Style="{StaticResource TF.Slider}" Margin="0,0,0,4"
                            Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" ToolTip="Sound volume" />
                    <UniformGrid x:Name="SoundChoices" Rows="1" Columns="3" Focusable="False"
                                ToolTip="Which idle sounds the companion makes" />
                    <UniformGrid x:Name="RateChoices" Rows="1" Columns="3" Focusable="False"
                                ToolTip="How often, roughly" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- The bird picker (SPEC-round5 2.3): click-toggled under the perch slot. StaysOpen for the same reason
             as the volume popup; the bar closes it itself on a press elsewhere on the note, when the note loses
             the foreground, on lock, on hide and once a bird is chosen. -->
        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=PerchSlot}" Placement="Bottom"
               VerticalOffset="2" HorizontalOffset="2" StaysOpen="True" AllowsTransparency="True"
               Focusable="False" PopupAnimation="None">
            <local:BirdPicker x:Name="Picker" />
        </Popup>
    </DockPanel>
</UserControl>
