<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The note's controls. Everything here is ink on paper: translucent ink tints instead of colours,
         so the same styles read well on all six swatches (Grey since round 5). Nothing is focusable: the caret must stay in the text. -->

    <SolidColorBrush x:Key="TF.Ink" Color="#2B2A25" />
    <SolidColorBrush x:Key="TF.InkTrack" Color="#2B2A25" Opacity="0.22" />
    <SolidColorBrush x:Key="TF.InkFill" Color="#2B2A25" Opacity="0.62" />
    <SolidColorBrush x:Key="TF.InkHover" Color="#2B2A25" Opacity="0.10" />
    <SolidColorBrush x:Key="TF.InkPress" Color="#2B2A25" Opacity="0.18" />
    <SolidColorBrush x:Key="TF.Selection" Color="#4F8DFF" />
    <SolidColorBrush x:Key="TF.ThumbFill" Color="#FFFDF6" />
    <FontFamily x:Key="TF.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The note text: no chrome at all, so the paper is the only surface. Scroll bars hidden because the
         window always grows to fit; the ScrollViewer is only the host TextBox insists on. -->
    <Style x:Key="TF.NoteText" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TF.Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource TF.Ink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource TF.Selection}" />
        <Setter Property="SelectionOpacity" Value="0.32" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="False" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AllowDrop" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="0"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                  Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small square icon button (A-, A+, padlock). A soft tint on hover, a deeper one on press. -->
    <Style x:Key="TF.Glyph" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource TF.Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource TF.IconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="Transparent" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource TF.InkHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource TF.InkPress}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- - and +: the glyph button set in text, a touch heavier so the two letters read at a glance. -->
    <Style x:Key="TF.TextGlyph" TargetType="Button" BasedOn="{StaticResource TF.Glyph}">
        <Setter Property="Width" Value="18" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Round 3 (item 2): the font switch is a lone italic serif f between - and +; the font's name lives
         in the tooltip only, so the button is one fixed width whatever the font. -->
    <Style x:Key="TF.FontGlyph" TargetType="Button" BasedOn="{StaticResource TF.Glyph}">
        <Setter Property="Width" Value="20" />
        <Setter Property="FontFamily" Value="Georgia, Times New Roman" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- A colour swatch: a filled circle, ringed in ink when chosen. Background = the colour,
         BorderBrush = its darker outline so a yellow swatch still shows on a yellow bar.
         Round 3 (item 1): the ring sat half a pixel off the disc, because the two ellipses had different
         sizes in an odd-width cell and layout rounding moved each one separately. Now both are the same
         18 DIP ellipse in one Grid cell (identical bounds, one centre) and the disc is shrunk by a render
         transform about its own centre, which layout rounding never touches, so they cannot drift apart. -->
    <Style x:Key="TF.Swatch" TargetType="RadioButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Width="18" Height="24" Background="Transparent">
                        <Ellipse x:Name="Ring" Width="18" Height="18" Stroke="{StaticResource TF.Ink}"
                                 StrokeThickness="1.4" Opacity="0" />
                        <!-- 18 x 0.78 = 14 DIP at rest; the stroke is scaled too, so 1.3 draws about 1. -->
                        <Ellipse x:Name="Fill" Width="18" Height="18" Fill="{TemplateBinding Background}"
                                 Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.3"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="0.78" ScaleY="0.78" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            <!-- 12 DIP inside the 18 DIP ring: a clear gap, both on one centre. -->
                            <Setter TargetName="Fill" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.667" ScaleY="0.667" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Fill" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider parts: the left of the thumb is drawn as the filled track, the right is the bare track behind. -->
    <Style x:Key="TF.SliderEmpty" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TF.SliderFilled" TargetType="RepeatButton" BasedOn="{StaticResource TF.SliderEmpty}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="3" CornerRadius="1.5" Margin="1,0,-3,0" VerticalAlignment="Center"
                                Background="{StaticResource TF.InkFill}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TF.SliderThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="Knob" Fill="{StaticResource TF.ThumbFill}" Stroke="{StaticResource TF.Ink}"
                             StrokeThickness="1.3" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.18" ScaleY="1.18" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TF.Slider" TargetType="Slider">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="22" Background="Transparent">
                        <Border Height="3" CornerRadius="1.5" Margin="2,0" VerticalAlignment="Center"
                                Background="{StaticResource TF.InkTrack}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TF.SliderFilled}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TF.SliderEmpty}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource TF.SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The bar's toggles (round 2; 22 DIP wide since round 3 so the one row stays under 400). A toggle is the glyph button with a state: the glyph sits at 70 % ink
         when off and full ink when on, so the state reads at a glance without any colour. -->
    <Style x:Key="TF.Toggle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Face" Background="Transparent" CornerRadius="5">
                        <ContentPresenter x:Name="Glyph" Opacity="0.7"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource TF.InkHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource TF.InkPress}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The 14 DIP vector glyphs. Stretch None keeps the coordinates in the Data literal, so every glyph
         is drawn on the same 14 x 14 grid and they line up with each other. -->
    <Style x:Key="TF.GlyphFill" TargetType="Path">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Fill" Value="{StaticResource TF.Ink}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="TF.GlyphStroke" TargetType="Path" BasedOn="{StaticResource TF.GlyphFill}">
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="Stroke" Value="{StaticResource TF.Ink}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!-- The bird of the opacity toggle, shared by its solid and its faded form: body, head, beak, tail. -->
    <Geometry x:Key="TF.BirdGlyph">F1 M 1.5,8.6 A 4.6,3.6 0 1 0 10.7,8.6 A 4.6,3.6 0 1 0 1.5,8.6 Z M 7.2,5.2 A 2.6,2.6 0 1 0 12.4,5.2 A 2.6,2.6 0 1 0 7.2,5.2 Z M 12,4.4 L 13.9,5.3 L 12,6.2 Z M 2.2,7.6 L 0.2,5.8 L 0.6,9.6 Z</Geometry>

    <!-- The cucumber slice (SPEC-round2 2.9, the colours of the 2.4 glyph): dark rim, pale flesh, three seeds.
         One drawing for the bar (14 DIP) and the carried slice (20 DIP), so both are the same slice. -->
    <DrawingImage x:Key="TF.CucumberSlice">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#3E7D3E">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="7,7" RadiusX="7" RadiusY="7" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#9CCB7A">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="7,7" RadiusX="5.7" RadiusY="5.7" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#DDF3C9">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="7,7" RadiusX="5" RadiusY="5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#B9D98C">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="7,4.6" RadiusX="0.9" RadiusY="1.4" />
                            <EllipseGeometry Center="9.1,8.2" RadiusX="0.9" RadiusY="1.4">
                                <EllipseGeometry.Transform>
                                    <RotateTransform Angle="120" CenterX="9.1" CenterY="8.2" />
                                </EllipseGeometry.Transform>
                            </EllipseGeometry>
                            <EllipseGeometry Center="4.9,8.2" RadiusX="0.9" RadiusY="1.4">
                                <EllipseGeometry.Transform>
                                    <RotateTransform Angle="-120" CenterX="4.9" CenterY="8.2" />
                                </EllipseGeometry.Transform>
                            </EllipseGeometry>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- The slice's grab handle on the bar: the glyph button's hover tint, on a plain border so the note
         can run the drag itself (a Button would swallow the move). -->
    <Style x:Key="TF.SliceHandle" TargetType="Border">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TF.InkHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Round 3: a choice in the volume popup (chirp / brrrp / both, often / mid / rarely). Plain ink text;
         the bar's code underlines the chosen one and dims the rest to 60 %. Never focusable, so a click in
         the popup leaves the caret in the note. -->
    <Style x:Key="TF.Choice" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource TF.Ink}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="Transparent" CornerRadius="4" Padding="5,1,5,2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource TF.InkHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource TF.InkPress}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round 4: the resize corner (SPEC-round4 2.4). A transparent 12 by 12 square so the whole corner takes
         the press, not just the strokes; three short diagonals in ink at 45 %, inset so the shortest one stays
         inside the paper's rounded corner. -->
    <SolidColorBrush x:Key="TF.InkGrip" Color="#2B2A25" Opacity="0.45" />
    <Style x:Key="TF.ResizeGrip" TargetType="Border">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeNWSE" />
        <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="TF.ResizeGripLines" TargetType="Path">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Stroke" Value="{StaticResource TF.InkGrip}" />
        <Setter Property="StrokeThickness" Value="1.1" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Data" Value="M 10.2,2.6 L 2.6,10.2 M 10.2,5.6 L 5.6,10.2 M 10.2,8.6 L 8.6,10.2" />
    </Style>
</ResourceDictionary>
